# ============================================================
# WhatsApp Business Listener Skill — Configuration Template
# ============================================================
# Copy this file to ".env" and fill in your values.
# Never commit the filled-in ".env" to version control.

# ------------------------------------------------------------------
# WhatsApp Business Cloud API
# ------------------------------------------------------------------

# Bearer token from the Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numeric phone-number-ID from the Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Token you entered in Meta App Dashboard → Webhooks → Verify Token
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here

# App Secret from the Meta App Dashboard → Settings → Basic
# Used to validate X-Hub-Signature-256 on every webhook request
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------------

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GPT model to use (gpt-4o-mini is fast and cost-effective)
GPT_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# Skill Behaviour
# ------------------------------------------------------------------

# System prompt injected at the start of every conversation
SYSTEM_PROMPT=You are a helpful, friendly, and concise assistant communicating through WhatsApp. Keep your answers brief and clear.

# Maximum number of messages (user + assistant combined) to retain per conversation
MAX_HISTORY=20

# ------------------------------------------------------------------
# Server (when running webhook_listener as a standalone Flask app)
# ------------------------------------------------------------------

# Port the Flask development server listens on
PORT=8080

# Set to "production" when deploying; "development" for local testing
FLASK_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
